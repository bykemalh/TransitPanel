{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransitJSON Agency",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string"
    },
    "city_id": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "properties": {
        "tr": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "required": [
        "tr"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Çoklu dil isim nesnesi. 'tr' zorunludur, diğer dil kodları (en, ar, de vb.) opsiyoneldir."
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "agency_id",
    "city_id",
    "name",
    "updated_at"
  ],
  "additionalProperties": false
}