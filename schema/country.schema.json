{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransitJSON Country",
  "type": "object",
  "properties": {
    "country_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 ülke kodu zorunludur, örn. TR"
    },
    "name": {
      "type": "object",
      "properties": {
        "tr": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "required": [
        "tr"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Çoklu dil isim nesnesi. 'tr' zorunludur, diğer dil kodları (en, ar, de vb.) opsiyoneldir."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "country_id",
    "name",
    "updated_at"
  ],
  "additionalProperties": false
}